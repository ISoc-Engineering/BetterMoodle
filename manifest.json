{
  "manifest_version": 3,
  "name": "BetterMoodle",
  "version": "0.1.0",
  "description": "A minimal, faster interface for UCL Moodle: deadlines first, slides in a side viewer, search everything with Ctrl+K.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BetterMoodle"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://moodle.ucl.ac.uk/*"],
      "js": ["src/early.js"],
      "css": ["src/styles/theme.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://moodle.ucl.ac.uk/*"],
      "js": [
        "src/lib/util.js",
        "src/lib/store.js",
        "src/lib/api.js",
        "src/features/viewer.js",
        "src/features/course.js",
        "src/features/home.js",
        "src/features/palette.js",
        "src/main.js"
      ],
      "css": ["src/styles/ui.css"],
      "run_at": "document_idle"
    }
  ]
}
