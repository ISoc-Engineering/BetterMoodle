{
  "manifest_version": 3,
  "name": "BetterMoodle — UCL study views",
  "version": "0.4.1",
  "description": "A section-based study hub for UCL Moodle with your real course imagery. Original Moodle is one click away.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://moodle.ucl.ac.uk/*"],
    "js": ["model.js", "content.js"],
    "css": ["host.css"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["ui.css", "fonts/inter-latin.woff2", "icons/book-open.svg", "icons/arrow-right.svg", "icons/x.svg", "icons/search.svg", "icons/layout-grid.svg", "icons/list.svg", "icons/file-text.svg", "icons/list-tree.svg", "icons/moodle.svg"],
    "matches": ["https://moodle.ucl.ac.uk/*"]
  }]
}
